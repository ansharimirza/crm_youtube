# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# JWT secret (generate: openssl rand -base64 32)
JWT_SECRET=

# Database (Postgres dipakai via docker-compose)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ytcrm
POSTGRES_PASSWORD=ytcrm_dev
POSTGRES_DB=ytcrm
DATABASE_URL=postgres://ytcrm:ytcrm_dev@postgres:5432/ytcrm

# Worker (VPS US)
WORKER_URL=http://worker:3001
WORKER_API_KEY=local_dev_secret_change_in_prod

# API
API_PORT=3000
WEB_PORT=5173
WORKER_PORT=3001

# Web
VITE_API_URL=http://localhost:3000

# Anthropic Claude — for TikTok Studio (claude-sonnet-4-6)
ANTHROPIC_API_KEY=
